<?xml version="1.0" encoding="utf-8"?>
<!-- 热搜词条：排名 + 词 + 热度 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginRight="@dimen/card_h_gap"
    android:layout_marginBottom="@dimen/card_h_gap"
    android:background="@drawable/focus_card"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:gravity="center_vertical"
    android:minHeight="62dp"
    android:orientation="horizontal"
    android:paddingLeft="@dimen/space_l"
    android:paddingRight="@dimen/space_l"
    android:paddingTop="@dimen/space_m"
    android:paddingBottom="@dimen/space_m">

    <TextView
        android:id="@+id/tvRank"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/brand"
        android:textSize="@dimen/text_subtitle"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWord"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_m"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/tvHot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/space_s"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_micro" />
</LinearLayout>
