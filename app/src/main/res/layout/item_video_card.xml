<?xml version="1.0" encoding="utf-8"?>
<!--
  视频卡片 —— 本次改版：纯封面
  ==========================
  设计变更（依据 docs/DESIGN.md 与原型）：
   · 卡片**只显示封面 + 角标**，标题/作者/播放量不再常驻
     → 一屏 10 条标题会互相抢注意力（"文字打架"），改为**焦点项的信息统一走下方信息栏**
   · 信息区保留 id（tvTitle/tvMeta）以便适配器继续绑定，但**置 gone**（高度 0）
   · 焦点：2dp 品牌色描边（@drawable/focus_card），无柔光
   · 间距收紧：横向 8dp / 纵向 12dp（令牌已改）

  为什么封面不是圆角：API 17 上没有 clipToOutline，ImageView 无法把 src 裁成圆角；
  靠卡片圆角 + 封面内缩 padding 达到收边效果（card_cover_inset 现为 0，圆角由卡片承担）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginRight="@dimen/tv_card_margin"
    android:layout_marginBottom="@dimen/tv_card_margin"
    android:background="@drawable/focus_card"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    android:padding="@dimen/card_cover_inset">

    <!-- 封面 + 角标 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/card_cover_height">

        <ImageView
            android:id="@+id/ivCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/cover_desc"
            android:scaleType="centerCrop" />

        <ProgressBar
            android:id="@+id/pbCover"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|right"
            android:layout_margin="@dimen/space_xs"
            android:background="@color/scrim_overlay"
            android:paddingLeft="@dimen/space_xs"
            android:paddingRight="@dimen/space_xs"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/tv_card_duration_bg_size" />

        <TextView
            android:id="@+id/tvVertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|left"
            android:layout_margin="@dimen/space_xs"
            android:background="@color/scrim_overlay"
            android:paddingLeft="@dimen/space_xs"
            android:paddingRight="@dimen/space_xs"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:text="竖屏"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/tv_card_duration_bg_size"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 信息区：本次改版置 gone（纯封面）。
         id 保留 → 适配器绑定不崩溃；标题/副信息改由首页「焦点信息栏」显示。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/tv_card_info_height"
        android:orientation="vertical"
        android:paddingLeft="@dimen/space_s"
        android:paddingRight="@dimen/space_s"
        android:paddingTop="@dimen/space_xs"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/tv_card_title_size" />

        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/tv_card_meta_size" />
    </LinearLayout>
</LinearLayout>
