<?xml version="1.0" encoding="utf-8"?>
<!--
  评论悬浮小窗（DialogFragment 的内容布局）
  ==========================================
  ★ 定位：贴着屏幕【右侧】的一块小面板，不是全屏页 ★

  为什么做成右侧窄面板（而不是底部/全屏）：
    · 抖音的视频绝大多数是竖屏 9:16。在 16:9 电视上按真实比例显示时，
      画面只占中间约 1/3 宽，两侧本来就是黑边 ——
      右侧面板正好落在黑边区域，【完全不遮挡画面主体】。
    · 横屏视频确实会重叠一部分，所以面板做成半透明 + 不压暗背景，
      让"视频还在播"这件事始终可见。

  与旧 CommentDialog（底部 62% 高）的区别：那个会盖住画面下缘，
  这正是被换掉的原因。

  TV 规则：
    ③ RecyclerView + descendantFocusability（不手搓 ScrollView）
    ④ 进入后显式给列表焦点（在 Fragment 里做）
    ① 列表自身 focusable
    6  加载/失败/空三态都走底部 status + 中央占位，不留黑屏
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/panel_bg"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_subtitle"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/focus_chip"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:minWidth="52dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="返回"
            android:textColor="@color/btn_text"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/divider" />

    <!-- 列表 + 占位 同层互斥 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pbLoading"
                android:layout_width="34dp"
                android:layout_height="34dp" />

            <TextView
                android:id="@+id/tvPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="正在加载评论…"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_tv_primary"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:minWidth="88dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="重试"
                android:textColor="@color/btn_text"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

    </FrameLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:textColor="@color/accent_warn"
        android:textSize="@dimen/text_micro" />

</LinearLayout>
