<?xml version="1.0" encoding="utf-8"?>
<!--
  登录页（独立）
  ==============
  与「设置」彻底分开：这一页只干登录这件事。
    ① 状态条：已登录 / 未登录（还显示 Cookie 规模）
    ② 手机扫码区：二维码 + 三步说明（电视上打不了字，所以主路径是手机）
    ③ 操作区：手动输入 Cookie / 退出登录 / 开始刷视频
  设置页只留诊断类入口，不再混登录。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:orientation="horizontal"
    android:padding="@dimen/tv_content_padding">

    <!-- 左：扫码 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivQr"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:background="#FFFFFFFF"
            android:padding="6dp" />

        <TextView
            android:id="@+id/tvUrl"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="http://---.---.---.---:8088"
            android:textColor="@color/brand"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <!-- 右：状态 + 说明 + 操作 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="@dimen/space_xl"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="登录抖音"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/tv_section_title_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:text="✗ 未登录"
            android:textColor="@color/accent_error"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:lineSpacingExtra="6dp"
            android:text="手机扫码登录（电视上不用打字）：\n1. 手机扫左边二维码\n2. 浏览器打开推送页\n3. 粘贴 Cookie → 点保存，本页会自动更新"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnManual"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tv_btn_height"
            android:layout_marginBottom="@dimen/space_s"
            android:background="@drawable/focus_chip"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/space_l"
            android:paddingRight="@dimen/space_l"
            android:text="⌨  手动输入 Cookie"
            android:textColor="@color/btn_text"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tv_btn_height"
            android:layout_marginBottom="@dimen/space_s"
            android:background="@drawable/focus_chip"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/space_l"
            android:paddingRight="@dimen/space_l"
            android:text="⎋  退出登录"
            android:textColor="@color/btn_text"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="@dimen/tv_btn_height"
            android:background="@drawable/focus_chip"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:paddingLeft="@dimen/space_l"
            android:paddingRight="@dimen/space_l"
            android:text="▶  开始刷视频"
            android:textColor="@color/btn_text"
            android:textSize="@dimen/text_body" />
    </LinearLayout>
</LinearLayout>
