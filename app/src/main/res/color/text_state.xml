<?xml version="1.0" encoding="utf-8"?>
<!-- 通用文字态：聚焦/选中=白，常态=次白 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/text_primary" />
    <item android:state_selected="true" android:color="@color/text_primary" />
    <item android:color="@color/text_secondary" />
</selector>
