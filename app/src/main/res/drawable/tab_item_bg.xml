<?xml version="1.0" encoding="utf-8"?>
<!-- 分类 Tab：常态透明、聚焦白描边、选中品牌色实底 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface_hi" />
            <corners android:radius="999dp" />
            <stroke android:width="@dimen/focus_stroke_width" android:color="@color/focus_stroke" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_chip" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
