<?xml version="1.0" encoding="utf-8"?>
<!--
  封面加载失败兜底图。

  与 cover_placeholder 视觉上刻意区分（这里偏红棕），
  便于现场一眼判断"是加载失败"还是"还在加载"。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF2A1D1D" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- 中央一个"叉"的抽象表达：两条交叉的细长条 -->
    <item
        android:width="44dp"
        android:height="6dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="#66FFFFFF" />
        </shape>
    </item>
    <item
        android:width="6dp"
        android:height="44dp"
        android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="#66FFFFFF" />
        </shape>
    </item>
</layer-list>
